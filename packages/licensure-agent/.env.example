# Local development configuration.
# For deployment, these are set via Terraform / the deploy command.
#
# Default is the Gemini API via Google AI Studio, because it is the path that
# works with nothing but a key — get one free at https://aistudio.google.com/apikey.
# Vertex needs a GCP project, billing, and gcloud auth, which is a lot to ask of
# someone who only wants to watch the agent run once.

GEMINI_API_KEY=your-api-key-here

# Alternatively, for Vertex AI — comment out the line above and uncomment these:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
